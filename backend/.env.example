# Copia este archivo a .env y ajusta los valores. Todas las variables llevan el prefijo AUTOS_.

# SQLite para desarrollo. Para PostgreSQL: postgresql+psycopg://usuario:clave@localhost:5432/autos_colombia
# (instala también el driver: pip install "psycopg[binary]")
AUTOS_DATABASE_URL=sqlite:///./autos_colombia.db

# OBLIGATORIO cambiarla en producción: cadena larga y aleatoria (python -c "import secrets; print(secrets.token_urlsafe(48))")
AUTOS_SECRET_KEY=clave-de-desarrollo-cambiala-en-produccion-1234567890

# Minutos que dura la sesión
AUTOS_TOKEN_MINUTES=480

# Orígenes permitidos por CORS, separados por coma
AUTOS_CORS_ORIGINS=http://localhost:4200

# Datos de ejemplo (empleados, 30 celdas, clientes). Ponlo en false en producción.
AUTOS_SEED_DEMO=true
AUTOS_SEED_PASSWORD=demo1234
